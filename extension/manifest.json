{
  "manifest_version": 3,
  "name": "Recipe to Cart",
  "version": "0.5.0",
  "description": "Turns a recipe page into a Walmart cart: reads the ingredients, skips pantry staples, picks the cheapest match. Never checks out.",
  "action": {
    "default_title": "Recipe to Cart: shop for this recipe"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "background",
    "offscreen",
    "power",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.walmart.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://ntfy.sh/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "options_page": "settings.html"
}
